# ============================================================================
# ZENFOCUS - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and provide your secret credentials.
# NOTE: .env is ignored by Git to protect private keys.
# ============================================================================

# Backend API Endpoint
EXPO_PUBLIC_API_URL=https://api.zenfocus.app/v1

# Push Notification Service Keys (Never commit private keys!)
EXPO_PUBLIC_FCM_PROJECT_ID=zenfocus-production
EXPO_PUBLIC_APNS_BUNDLE_ID=com.zenfocus.app

# Analytics & Monitoring (Optional)
EXPO_PUBLIC_ANALYTICS_ENABLED=false
